# Copy to /etc/apartment15.env and edit.
#   sudo cp deploy/pi/apartment15.env.example /etc/apartment15.env
#   sudo nano /etc/apartment15.env
#   sudo systemctl restart apartment15

PORT=8765

# LAN URL tablets use (MainUI iframes + export YAML). Use the Pi's IP.
A15_PUBLIC_URL=http://192.168.1.100:8765

# openHAB REST on the same machine (server-side proxy only).
A15_OPENHAB_URL=http://127.0.0.1:8080

# MainUI → profile → Create API Token (paste the oh.… value).
A15_OPENHAB_TOKEN=

# Allow CAD/API from LAN browsers
A15_CORS=*

# Allow MainUI to iframe Apartment15 (space-separated origins)
A15_FRAME_ANCESTORS="http://192.168.1.100:8080 http://127.0.0.1:8080"

# Soft auth (leave unset). Set to 1 only if you need login on the Pi.
# A15_AUTH=0
